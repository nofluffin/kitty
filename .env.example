# Copy to .env.local in apps/web and apps/mobile as needed. Never commit real values.
# Local values come from `npm run db:status`.

# --- apps/web (Next.js server routes only) ---
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=            # server only, never sent to the browser

# --- apps/mobile (Expo; EXPO_PUBLIC_ values are bundled into the app) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_MEMBER_PAGE_URL=http://127.0.0.1:3456

# --- Supabase edge functions (supabase/functions/.env) ---
ANTHROPIC_API_KEY=                    # bill scan function only (step 8)

# --- Later steps ---
RESEND_API_KEY=                       # email login codes in the pilot (step 3)
SENTRY_DSN=
EXPO_TOKEN=                           # EAS builds in CI
